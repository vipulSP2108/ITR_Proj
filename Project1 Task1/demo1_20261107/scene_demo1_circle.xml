<mujoco model="openmanipulator_x_demo1_circle">
  <compiler angle="radian" coordinate="local"/>
  <option gravity="0 0 -9.81" timestep="0.002" integrator="implicitfast" solver="Newton" iterations="30"/>

  <visual>
    <headlight ambient="0.45 0.45 0.45" diffuse="0.8 0.8 0.8" specular="0.15 0.15 0.15"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global offwidth="1280" offheight="720"/>
  </visual>

  <asset>
    <material name="mat_table" rgba="0.30 0.32 0.35 1" specular="0.2"/>
    <material name="mat_green_pad" rgba="0.20 0.70 0.50 1" specular="0.1"/>
    <material name="mat_board" rgba="0.85 0.65 0.45 1" specular="0.1"/>
    <material name="mat_robot_dark" rgba="0.18 0.18 0.20 1"/>
    <material name="mat_robot_white" rgba="0.88 0.88 0.90 1"/>
    <material name="mat_green_peg" rgba="0.15 0.85 0.25 1"/>
    <material name="mat_socket_red" rgba="0.88 0.15 0.15 1"/>
    <material name="mat_hole" rgba="0.10 0.10 0.10 1"/>
    <material name="mat_aluminum" rgba="0.80 0.82 0.85 1"/>
  </asset>

  <worldbody>
    <!-- Lighting -->
    <light directional="true" pos="0.2 0 3" dir="0 0 -1" diffuse="0.85 0.85 0.85"/>
    <light directional="false" pos="0.5 -0.5 1.5" diffuse="0.4 0.4 0.4"/>

    <!-- Floor -->
    <geom name="floor" type="plane" size="3 3 0.1" pos="0 0 -0.72" rgba="0.35 0.35 0.37 1"/>

    <!-- Tabletop -->
    <geom name="table" type="box" size="0.45 0.51 0.02" pos="-0.15 -0.30 0" material="mat_table"/>

    <!-- Aluminium rail along the +Y table edge -->
    <geom name="rail" type="box" size="0.158 0.016 0.016" pos="0.065 0.148 0.035" material="mat_aluminum"/>

    <!-- Green foam working mat (pickup area) -->
    <geom name="green_mat" type="box" size="0.125 0.125 0.005" pos="0.109 0.0 0.025" material="mat_green_pad"/>

    <!-- Wooden shape board -->
    <geom name="socket_board" type="box" size="0.036 0.125 0.004" pos="0.245 0.000 0.024" material="mat_board"/>

    <!-- Circle Socket (Red border + dark interior) -->
    <geom name="socket_circ_outline" type="cylinder" size="0.021 0.0002" pos="0.240 -0.080 0.0282" material="mat_socket_red" contype="0" conaffinity="0"/>
    <geom name="socket_circ_hole"    type="cylinder" size="0.018 0.0002" pos="0.240 -0.080 0.0285" material="mat_hole" contype="0" conaffinity="0"/>

    <!-- Reference passive socket markers for other positions -->
    <geom name="socket_hex_ref"  type="cylinder" size="0.016 0.0002" pos="0.240 -0.027 0.0282" material="mat_socket_red" contype="0" conaffinity="0"/>
    <geom name="socket_sq_ref"   type="box"      size="0.015 0.015 0.0002" pos="0.240  0.027 0.0282" material="mat_socket_red" contype="0" conaffinity="0"/>
    <geom name="socket_tri_ref"  type="cylinder" size="0.014 0.0002" pos="0.240  0.080 0.0282" material="mat_socket_red" contype="0" conaffinity="0"/>

    <!-- RealSense Overhead Camera -->
    <camera name="overhead_realsense" pos="0.18 -0.01 0.54" xyaxes="-1 0 0 0 -1 0" fovy="58" mode="fixed"/>

    <!-- Exactly 1 Peg for Demo 1: Green Circle Peg (standing stably on green mat) -->
    <body name="peg_circ" pos="0.179 -0.055 0.060">
      <freejoint name="jnt_peg_circ"/>
      <geom type="cylinder" size="0.016 0.035" material="mat_green_peg" mass="0.08" friction="3.5 0.5 0.2" condim="4" solref="0.005 1" solimp="0.95 0.99 0.001"/>
    </body>

    <!-- ==================== ROBOTIS OpenMANIPULATOR-X ==================== -->
    <body name="robot_base" pos="0 0 0.02">
      <geom type="cylinder" size="0.05 0.015" pos="0 0 0.015" material="mat_robot_dark"/>
      <geom type="box" size="0.035 0.035 0.02" pos="0 0 0.050" material="mat_robot_dark"/>

      <!-- Joint 1: Base Pan (Rotation around Z) -->
      <body name="link1" pos="0 0 0.077">
        <joint name="joint1" type="hinge" axis="0 0 1" range="-3.14 3.14" damping="2.0" armature="0.02"/>
        <geom type="cylinder" size="0.028 0.018" pos="0 0 0" material="mat_robot_dark"/>
        
        <!-- Joint 2: Shoulder Pitch (Rotation around Y) -->
        <body name="link2" pos="0 0 0">
          <joint name="joint2" type="hinge" axis="0 1 0" range="-1.57 1.57" damping="3.0" armature="0.02"/>
          <geom type="capsule" size="0.020" fromto="0 0 0 0 0 0.130" material="mat_robot_white"/>
          <geom type="box" size="0.018 0.022 0.015" pos="0 0 0.130" material="mat_robot_dark"/>

          <!-- Joint 3: Elbow Pitch (Rotation around Y) -->
          <body name="link3" pos="0 0 0.130">
            <joint name="joint3" type="hinge" axis="0 1 0" range="-1.8 1.8" damping="2.0" armature="0.02"/>
            <geom type="capsule" size="0.018" fromto="0 0 0 0.124 0 0" material="mat_robot_white"/>
            <geom type="box" size="0.015 0.022 0.018" pos="0.124 0 0" material="mat_robot_dark"/>

            <!-- Joint 4: Wrist Pitch (Rotation around Y) -->
            <body name="link4" pos="0.124 0 0">
              <joint name="joint4" type="hinge" axis="0 1 0" range="-1.9 1.9" damping="1.5" armature="0.02"/>
              <geom type="capsule" size="0.016" fromto="0 0 0 0.06 0 0" material="mat_robot_dark"/>

              <!-- Gripper Base & Center -->
              <body name="gripper_base" pos="0.06 0 0">
                <geom type="box" size="0.018 0.030 0.015" pos="0.01 0 0" material="mat_robot_dark"/>

                <!-- Left Gripper Finger -->
                <body name="gripper_finger_left" pos="0.02 0.025 0">
                  <joint name="gripper_left" type="slide" axis="0 1 0" range="-0.025 0.025" damping="1.0" armature="0.01"/>
                  <geom type="box" size="0.035 0.005 0.015" pos="0.035 0 0" material="mat_robot_white" friction="3.5 0.5 0.2" condim="4" solref="0.005 1" solimp="0.95 0.99 0.001"/>
                </body>

                <!-- Right Gripper Finger -->
                <body name="gripper_finger_right" pos="0.02 -0.025 0">
                  <joint name="gripper_right" type="slide" axis="0 1 0" range="-0.025 0.025" damping="1.0" armature="0.01"/>
                  <geom type="box" size="0.035 0.005 0.015" pos="0.035 0 0" material="mat_robot_white" friction="3.5 0.5 0.2" condim="4" solref="0.005 1" solimp="0.95 0.99 0.001"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <contact>
    <exclude body1="robot_base" body2="link1"/>
    <exclude body1="link1" body2="link2"/>
    <exclude body1="link2" body2="link3"/>
    <exclude body1="link3" body2="link4"/>
    <exclude body1="link4" body2="gripper_base"/>
    <exclude body1="gripper_base" body2="gripper_finger_left"/>
    <exclude body1="gripper_base" body2="gripper_finger_right"/>
    <exclude body1="gripper_finger_left" body2="gripper_finger_right"/>
  </contact>

  <actuator>
    <position name="act_joint1" joint="joint1" kp="80" kv="12"/>
    <position name="act_joint2" joint="joint2" kp="100" kv="15"/>
    <position name="act_joint3" joint="joint3" kp="80" kv="12"/>
    <position name="act_joint4" joint="joint4" kp="60" kv="8"/>
    <position name="act_gripper_l" joint="gripper_left" kp="300" kv="25"/>
    <position name="act_gripper_r" joint="gripper_right" kp="300" kv="25"/>
  </actuator>
</mujoco>
