<mujoco model="openmanipulator_x_peg_sorting_sim_demo">
  <compiler angle="radian" coordinate="local"/>
  <option gravity="0 0 -9.81" timestep="0.002" integrator="implicitfast" solver="Newton" iterations="50" noslip_iterations="3"/>
  <visual>
